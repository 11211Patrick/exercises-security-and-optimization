FROM golang:1.16

EXPOSE 8080

WORKDIR /usr/src/app

COPY code/example-backend .

ENV REQUEST_ORIGIN=http://localhost:5001

RUN go build && \
    go test ./... && \
    go clean -cache -modcache && \
    useradd -m appuser && \
    chown appuser .

# now we can change the user
USER appuser

CMD ["./server"]
