FROM node:16.20.2-alpine3.18

EXPOSE 5001

WORKDIR /usr/src/app

COPY code/example-frontend .

ENV REACT_APP_BACKEND_URL=http://localhost:8080

RUN npm install && \
    npm run build && \
    npm install -g serve && \
    rm -rf src node_modules && \
    npm cache clean --force && \
    adduser -D appuser && \
    chown appuser .

# now we can change the user
USER appuser

CMD ["serve", "-s", "-l", "5001", "build"]
