FROM golang:1.16

EXPOSE 8080

WORKDIR /usr/src/app

COPY code/example-backend .

ENV REQUEST_ORIGIN=http://localhost:5001

RUN go build

RUN go test ./...

# create the appuser
RUN useradd -m appuser

# change the owner of current dir to appuser
RUN chown appuser .

# now we can change the user
USER appuser

CMD ["./server"]
